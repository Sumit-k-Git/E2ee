# ── vault.msg root .env ───────────────────────────────────────────────────
# Copy this to .env and fill in all values before running docker compose.
# NEVER commit .env to git.

# ── Your domain ───────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com

# ── Vite build-time URLs (used by Docker build args) ──────────────────────
VITE_API_URL=https://yourdomain.com/api
VITE_WS_URL=wss://yourdomain.com/ws

# ── JWT secrets — generate with:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_ME_WITH_128_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_ME_WITH_DIFFERENT_128_CHAR_HEX

# ── SSL (Let's Encrypt) ───────────────────────────────────────────────────
CERT_EMAIL=your@email.com
