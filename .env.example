# ═══════════════════════════════════════════════════════════════
#  vault.msg — Environment Configuration
#  Copy this file to .env and fill in every value marked REQUIRED
# ═══════════════════════════════════════════════════════════════

# ── Your domain ───────────────────────────────────────────────
# REQUIRED: your domain name (no https://, no trailing slash)
DOMAIN=yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api
VITE_WS_URL=wss://yourdomain.com/ws

# ── JWT Secrets ────────────────────────────────────────────────
# REQUIRED: run this command twice to get two different secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
OTP_SECRET=REPLACE_WITH_THIRD_LONG_RANDOM_SECRET

# ── SSL Certificate (Let's Encrypt) ───────────────────────────
# REQUIRED for production TLS
CERT_EMAIL=your@email.com

# ── Email / OTP Settings ───────────────────────────────────────
# Choose ONE provider below.
#
# OPTION 1: Gmail (recommended — easiest setup)
#   Get app password: Google Account → Security → 2FA → App passwords
EMAIL_PROVIDER=gmail
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=vault.msg <your.gmail@gmail.com>
#
# OPTION 2: Generic SMTP
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=yourpassword
# EMAIL_FROM=vault.msg <noreply@yourdomain.com>
#
# OPTION 3: Development mode — OTP codes printed to docker logs (no real email)
# EMAIL_PROVIDER=dev

# ── Server settings ────────────────────────────────────────────
# (defaults are fine for most deployments)
PORT=4000
NODE_ENV=production
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
DB_PATH=/data/vault.db
