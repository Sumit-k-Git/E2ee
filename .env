# ── vault.msg environment config ──────────────────────────────
# Copy to .env:  cp .env.example .env
# Then fill in the values marked REQUIRED

# ── Domain (REQUIRED for production) ──────────────────────────
DOMAIN=yourdomain.com
ALLOWED_ORIGIN=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api
VITE_WS_URL=wss://yourdomain.com/ws

# ── Secrets (REQUIRED — generate with commands below) ─────────
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cde3e416d26d9a4db9b7ac7823f3f9418b8bd051f6e0e8dcd00f74576d2f55351f7b5f0e453ed468d7b010da339e55b5c532dc379b989d56cdd1f432a9291531
JWT_REFRESH_SECRET=6cc0ba88f44dbfc66263a89e5007d2260ec3893d7e32b13678a6008293b10a58ce4c9e0c76e1b8caeda1da4b0a33bf747b57117ab094e68d93f7513424390173
OTP_SECRET=8fe59253817402e13583b9422314e569edf76342a721209dbe6ed15f9b962d1397d032439668f978efc2c6c68fe9ec0554bc4a395b0c4a45528d5ffe558a06ef

# ── SSL (REQUIRED for production) ─────────────────────────────
CERT_EMAIL=your@email.com

# ── Email for OTP ──────────────────────────────────────────────
# Option 1: Dev mode — OTP codes printed to server logs (no email needed)
EMAIL_PROVIDER=dev

# Option 2: Gmail
# EMAIL_PROVIDER=gmail
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your_16char_app_password

# Option 3: Any SMTP
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=yourpassword
