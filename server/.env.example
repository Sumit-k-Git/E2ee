# vault.msg server — environment config
# For Railway: paste these into the Variables tab

NODE_ENV=production
PORT=4000

# Your frontend URL (Vercel URL — no trailing slash)
ALLOWED_ORIGIN=https://your-app.vercel.app

# JWT Secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=

# ─────────────────────────────────────────────────────
# EMAIL PROVIDER — choose one option below
# ─────────────────────────────────────────────────────

# OPTION 1: Dev mode (default)
# OTP codes shown on website — fine for testing, NOT for production
EMAIL_PROVIDER=dev

# OPTION 2: Brevo (RECOMMENDED — free, 300 emails/day, easy setup)
# 1. Sign up free at https://www.brevo.com
# 2. Go to Settings → SMTP & API → SMTP tab
# 3. Copy your login email and SMTP key
# EMAIL_PROVIDER=brevo
# EMAIL_USER=your-brevo-login@email.com
# BREVO_SMTP_KEY=your-brevo-smtp-key
# EMAIL_FROM=vault.msg <noreply@yourdomain.com>

# OPTION 3: Gmail
# 1. Enable 2FA on Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create App Password for "Mail"
# EMAIL_PROVIDER=gmail
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM=vault.msg <your@gmail.com>
