# vault.msg server — environment config
# For Railway: paste these into the Variables tab

NODE_ENV=production
PORT=4000

# Your frontend URL (Vercel URL — no trailing slash)
ALLOWED_ORIGIN=https://your-app.vercel.app

# JWT Secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=

# ─────────────────────────────────────────────────────
# EMAIL PROVIDER — choose one option below
# ─────────────────────────────────────────────────────

# OPTION 1: Dev mode (default)
# OTP codes shown on website — fine for testing, NOT for production
EMAIL_PROVIDER=dev

# OPTION 2: Brevo HTTP API (RECOMMENDED for Railway — free, 300 emails/day)
# Setup steps:
#   1. Sign up at https://www.brevo.com
#   2. Go to Settings → SMTP & API → API Keys → create a new key
#   3. Go to Senders & IPs → Senders → Add & VERIFY your sender email
#   4. Set EMAIL_FROM to exactly the verified sender address from step 3
#
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com
#
# ⚠ EMAIL_FROM must match a verified sender in Brevo — this is what causes
#   "valid sender email required" (400 error) if it's missing or unverified!

# OPTION 3: Gmail (App Password)
# 1. Enable 2FA on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create App Password for "Mail"
# EMAIL_PROVIDER=gmail
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM=your@gmail.com
