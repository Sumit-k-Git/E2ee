# vault.msg server — local development
# Copy: cp .env.example .env

NODE_ENV=development
PORT=4000
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:4173

# Auto-generated by start-local.sh if left blank
JWT_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=

# Dev mode: OTP codes printed to terminal, no email needed
EMAIL_PROVIDER=dev

# Leave blank for auto-detection (uses /data, /tmp, or ./vault.db)
DB_PATH=
